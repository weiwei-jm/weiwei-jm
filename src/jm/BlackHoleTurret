package jm;

import mindustry.type.Category;
import mindustry.world.blocks.defense.turrets.Turret;
import mindustry.entities.bullet.BasicBulletType;
import mindustry.entities.bullet.BulletType;
import mindustry.type.ItemStack;
import mindustry.content.Items;
import mindustry.content.Fx;

public class BlackHoleTurret extends Turret {
    public BlackHoleTurret(String name) {
        super(name);
        this.size = 4; 
        this.health = 1800; 
        this.range = 400f; 
        this.reload = 300f; 
        this.targetAir = true; 
        this.targetGround = true; 
        this.category = Category.turret;
        
        this.itemCapacity = 0; 
        this.acceptCoolant = false; 
        this.consumeAmmo = false; 
        
        this.requirements(Category.turret, ItemStack.with(
            Items.copper, 1000,
            Items.lead, 800,
            Items.titanium, 500
        ));

        this.shootType = new BasicBulletType(0f, 0) {{
            lifetime = 1f;
            hitEffect = Fx.none;
            shootEffect = Fx.none;
        }};
    }

    public class BlackHoleTurretBuild extends TurretBuild {
        @Override
        protected void shoot(BulletType type) {
            super.shoot(type);
            
            if (target != null) {
                float tx = target.x;
                float ty = target.y;
                float offset = 20f + 5f; 

                for (int i = 0; i < 4; i++) {
                    float ox = (i % 2 == 0 ? offset : -offset);
                    float oy = (i < 2 ? offset : -offset);
                    
                    BuilderDroneUnit drone = new BuilderDroneUnit();
                    drone.x = this.x;
                    drone.y = this.y;
                    drone.targetPos.set(tx + ox, ty + oy);
                    drone.add();
                }
            }
        }
    }
}
